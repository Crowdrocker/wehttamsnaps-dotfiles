// WehttamSnaps Niri Keybindings
// Author: Matthew (Crowdrocker)
// Hardware: Dell XPS 8700 - i7-4790 @ 4.0GHz, RX 580, 16GB RAM
// Display: DP-2 1920x1080@60Hz
// GitHub: https://github.com/Crowdrocker/wehttamsnaps-dotfiles

// ╭─────────────────────────────── KEYBINDINGS ──────────────────────────────────────╮
//
// LAYOUT:
//   1. System / Niri core
//   2. ii (Quickshell DankMaterialShell) IPC
//   3. J.A.R.V.I.S. voice + menu system
//   4. Window management
//   5. Focus movement
//   6. Window movement
//   7. Applications
//   8. Webapps
//   9. Gaming
//  10. Screenshots
//  11. Audio + Media
//
// ╰──────────────────────────────────────────────────────────────────────────────────╯

binds {

    // ╭─────────────────────────────── 1. SYSTEM / NIRI CORE ────────────────────────╮

    Mod+Tab         repeat=false    hotkey-overlay-title="Toggle Overview"      { toggle-overview; }
    Mod+Shift+E                     hotkey-overlay-title="Quit Niri"            { quit; }
    Mod+Escape      allow-inhibiting=false  hotkey-overlay-title="Toggle KB Inhibit" { toggle-keyboard-shortcuts-inhibit; }

    // Alt+Tab window switcher (ii/Quickshell)
    Alt+Tab         hotkey-overlay-title="Window: Next"     { spawn "qs" "-c" "ii" "ipc" "call" "altSwitcher" "next"; }
    Alt+Shift+Tab   hotkey-overlay-title="Window: Previous" { spawn "qs" "-c" "ii" "ipc" "call" "altSwitcher" "previous"; }

    // ╰──────────────────────────────────────────────────────────────────────────────╯

    // ╭─────────────────────────────── 2. ii (QUICKSHELL) IPC ───────────────────────╮

    Mod+V           hotkey-overlay-title="Clipboard History"    { spawn "qs" "-c" "ii" "ipc" "call" "clipboard" "toggle"; }
    Mod+Alt+L       allow-when-locked=true  hotkey-overlay-title="Lock Screen"  { spawn "qs" "-c" "ii" "ipc" "call" "lock" "activate"; }
    Mod+Comma       hotkey-overlay-title="Settings"             { spawn "qs" "-c" "ii" "ipc" "call" "settings" "open"; }
    Mod+Slash       hotkey-overlay-title="Cheatsheet"           { spawn "qs" "-c" "ii" "ipc" "call" "cheatsheet" "toggle"; }
    Mod+Shift+W     hotkey-overlay-title="Cycle Panel Style"    { spawn "qs" "-c" "ii" "ipc" "call" "panelFamily" "cycle"; }
    Mod+Shift+S     hotkey-overlay-title="Region Screenshot"    { spawn "qs" "-c" "ii" "ipc" "call" "region" "screenshot"; }
    Mod+Shift+X     hotkey-overlay-title="Region OCR"           { spawn "qs" "-c" "ii" "ipc" "call" "region" "ocr"; }
    Mod+Shift+A     hotkey-overlay-title="Region Search"        { spawn "qs" "-c" "ii" "ipc" "call" "region" "search"; }
    Ctrl+Alt+T      hotkey-overlay-title="Wallpaper Selector"   { spawn "qs" "-c" "ii" "ipc" "call" "wallpaperSelector" "toggle"; }

    // NOTE: Mod+Space was previously mapped to jarvis-menu main AND ii overview.
    // Keeping jarvis-menu as primary launcher — comment below to swap back to ii overview.
    // Mod+Space repeat=false hotkey-overlay-title="ii Overview" { spawn "qs" "-c" "ii" "ipc" "call" "overview" "toggle"; }

    // ╰──────────────────────────────────────────────────────────────────────────────╯

    // ╭─────────────────────────────── 3. J.A.R.V.I.S. ─────────────────────────────╮

    // Main command center (full menu)
    Mod+Space       hotkey-overlay-title="J.A.R.V.I.S. Menu"   { spawn "jarvis-menu" "main"; }

    // Quick launchers
    Mod+Alt+A       hotkey-overlay-title="J.A.R.V.I.S. Apps"       { spawn "jarvis-menu" "apps"; }
    Mod+W           hotkey-overlay-title="J.A.R.V.I.S. Workspaces" { spawn "jarvis-menu" "workspaces"; }
    Mod+Alt+Slash   hotkey-overlay-title="J.A.R.V.I.S. Command"    { spawn "jarvis-menu" "command"; }

    // Interactive terminal
    Mod+Alt+J       hotkey-overlay-title="J.A.R.V.I.S. Terminal"   { spawn "konsole" "-e" "jarvis" "interactive"; }

    // Ask J.A.R.V.I.S. via Rofi prompt
    Mod+Alt+K       hotkey-overlay-title="Ask J.A.R.V.I.S." {
        spawn "bash" "-c" "question=$(rofi -dmenu -p 'Ask J.A.R.V.I.S.') && [ -n \"$question\" ] && konsole -e bash -c \"source ~/.config/wehttamsnaps/scripts/jarvis-ai.sh && jarvis-ask '$question' && read -p 'Press Enter...'\"";
    }

    // Diagnostic shortcuts
    Mod+Alt+Shift+D hotkey-overlay-title="J.A.R.V.I.S. Diagnose"   { spawn "konsole" "-e" "bash" "-c" "source ~/.config/wehttamsnaps/scripts/jarvis-ai.sh && jarvis-diagnose && read -p 'Press Enter...'"; }
    Mod+Alt+Shift+N hotkey-overlay-title="J.A.R.V.I.S. Niri Debug" { spawn "konsole" "-e" "bash" "-c" "source ~/.config/wehttamsnaps/scripts/jarvis-ai.sh && jarvis-debug-niri && read -p 'Press Enter...'"; }
    Mod+Alt+Shift+E hotkey-overlay-title="J.A.R.V.I.S. Last Error" { spawn "konsole" "-e" "bash" "-c" "source ~/.config/wehttamsnaps/scripts/jarvis-ai.sh && jarvis-explain-error && read -p 'Press Enter...'"; }
    Mod+Alt+Shift+G hotkey-overlay-title="J.A.R.V.I.S. Game Debug" { spawn "konsole" "-e" "bash" "-c" "source ~/.config/wehttamsnaps/scripts/jarvis-ai.sh && jarvis-proton-debug && read -p 'Press Enter...'"; }

    // Keyhints cheat sheet
    Mod+Alt+H       hotkey-overlay-title="KeyHints"     { spawn "sh" "-c" "~/.config/wehttamsnaps/scripts/KeyHints.sh"; }

    // Niri config parser / keybind viewer
    Mod+Shift+C     hotkey-overlay-title="Niri Keybind Parser" { spawn "python3" "~/.config/niri/niri_keybind_parser.py" "~/.config/niri/10-wiri_keybinds.kdl" "html"; }

    // ╰──────────────────────────────────────────────────────────────────────────────╯

    // ╭─────────────────────────────── 4. WINDOW MANAGEMENT ────────────────────────╮

    // FIX: was calling an external script for close — use niri native + sound instead
    Mod+Q           repeat=false    hotkey-overlay-title="Close Window"     { spawn "sh" "-c" "niri msg action close-window && sound-system window-close"; }
    Mod+D                           hotkey-overlay-title="Maximize Column"  { maximize-column; }
    Mod+F                           hotkey-overlay-title="Fullscreen"       { fullscreen-window; }
    Mod+A                           hotkey-overlay-title="Toggle Float"     { toggle-window-floating; }

    // Resize columns
    Mod+R           hotkey-overlay-title="Preset Width"    { switch-preset-column-width; }
    Mod+Shift+R     hotkey-overlay-title="Preset Height"   { switch-preset-window-height; }
    Mod+Minus                                               { set-column-width "-10%"; }
    Mod+Equal                                               { set-column-width "+10%"; }
    Mod+Shift+Minus                                         { set-window-height "-10%"; }
    Mod+Shift+Equal                                         { set-window-height "+10%"; }
    Mod+Alt+C       hotkey-overlay-title="Center Column"   { center-column; }

    // Column/window tiling
    Mod+BracketLeft     hotkey-overlay-title="Consume Left"     { consume-or-expel-window-left; }
    Mod+BracketRight    hotkey-overlay-title="Expel Right"      { consume-or-expel-window-right; }

    // ╰──────────────────────────────────────────────────────────────────────────────╯

    // ╭─────────────────────────────── 5. FOCUS MOVEMENT ───────────────────────────╮

    Mod+Left    { focus-column-left; }
    Mod+Right   { focus-column-right; }
    Mod+Up      { focus-window-up; }
    Mod+Down    { focus-window-down; }

    // Vim-style (H/J/K/L — note: L not semicolon, matches your KeyHints.sh docs)
    Mod+H       { focus-column-left; }
    Mod+J       { focus-window-down; }
    Mod+K       { focus-window-up; }
    Mod+L       { focus-column-right; }

    // ╰──────────────────────────────────────────────────────────────────────────────╯

    // ╭─────────────────────────────── 6. WINDOW MOVEMENT ──────────────────────────╮

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }

    // ╰──────────────────────────────────────────────────────────────────────────────╯

    // ╭─────────────────────────────── 7. WORKSPACES ────────────────────────────────╮

    // Switch workspace + play sound-system voice feedback
    Mod+1 { spawn "sh" "-c" "niri msg action focus-workspace 1 && sound-system workspace 1"; }
    Mod+2 { spawn "sh" "-c" "niri msg action focus-workspace 2 && sound-system workspace 2"; }
    Mod+3 { spawn "sh" "-c" "niri msg action focus-workspace 3 && sound-system workspace 3"; }
    Mod+4 { spawn "sh" "-c" "niri msg action focus-workspace 4 && sound-system workspace 4"; }
    Mod+5 { spawn "sh" "-c" "niri msg action focus-workspace 5 && sound-system workspace 5"; }
    Mod+6 { spawn "sh" "-c" "niri msg action focus-workspace 6 && sound-system workspace 6"; }
    Mod+7 { spawn "sh" "-c" "niri msg action focus-workspace 7 && sound-system workspace 7"; }
    Mod+8 { spawn "sh" "-c" "niri msg action focus-workspace 8 && sound-system workspace 8"; }
    Mod+9 { spawn "sh" "-c" "niri msg action focus-workspace 9 && sound-system workspace 9"; }
    Mod+0 { spawn "sh" "-c" "niri msg action focus-workspace 10 && sound-system workspace 10"; }

    // Move window to workspace
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // ╰──────────────────────────────────────────────────────────────────────────────╯

    // ╭─────────────────────────────── 8. APPLICATIONS ─────────────────────────────╮

    // Terminal (two binds, same action — Mod+Return is muscle memory from i3/sway)
    Mod+Return      hotkey-overlay-title="Terminal (Ghostty)"   { spawn "ghostty"; }
    Mod+T           hotkey-overlay-title="Terminal (Ghostty)"   { spawn "ghostty"; }

    // Core apps
    Mod+B           hotkey-overlay-title="Firefox"          { spawn "firefox"; }
    Mod+Shift+B     hotkey-overlay-title="Brave"            { spawn "brave"; }
    Super+E         hotkey-overlay-title="File Manager"     { spawn "thunar"; }
    Mod+Shift+T     hotkey-overlay-title="Kate Editor"      { spawn "kate"; }
    Mod+P           hotkey-overlay-title="Spotify"          { spawn "spotify-launcher"; }
    Mod+O           hotkey-overlay-title="OBS Studio"       { spawn "flatpak" "run" "com.obsproject.Studio"; }
    Mod+Alt+D       hotkey-overlay-title="Rofi Launcher"    { spawn "rofi" "-show" "drun"; }

    // ╰──────────────────────────────────────────────────────────────────────────────╯

    // ╭─────────────────────────────── 9. WEBAPPS ───────────────────────────────────╮

    Mod+Ctrl+t  hotkey-overlay-title="Twitch"   { spawn "sh" "-c" "~/.config/wehttamsnaps/scripts/webapp-launcher.sh twitch"; }
    Mod+Ctrl+y  hotkey-overlay-title="YouTube"  { spawn "sh" "-c" "~/.config/wehttamsnaps/scripts/webapp-launcher.sh youtube"; }
    Mod+Ctrl+s  hotkey-overlay-title="Spotify"  { spawn "sh" "-c" "~/.config/wehttamsnaps/scripts/webapp-launcher.sh spotify"; }
    Mod+Ctrl+d  hotkey-overlay-title="Discord"  { spawn "sh" "-c" "~/.config/wehttamsnaps/scripts/webapp-launcher.sh discord"; }

    // ╰──────────────────────────────────────────────────────────────────────────────╯

    // ╭─────────────────────────────── 10. GAMING ───────────────────────────────────╮

    // FIX: Super+G (overlay) and Mod+G (gaming-toggle) are the SAME key on most keyboards.
    // Super == Mod. Keeping Mod+G as gaming toggle (more useful daily).
    // Moved ii overlay to Mod+Alt+G to avoid the conflict.
    Mod+G       hotkey-overlay-title="Gaming Mode Toggle"   { spawn "sound-system" "gaming-toggle"; }
    Mod+Alt+G   hotkey-overlay-title="ii Overlay"           { spawn "qs" "-c" "ii" "ipc" "call" "overlay" "toggle"; }

    // FIX: Mod+Shift+g (lowercase) and Mod+Shift+G were both bound (same key, different scripts).
    // jarvis-manager.sh kept here — remove if you don't use it separately from sound-system
    Mod+Shift+G hotkey-overlay-title="JARVIS Manager"       { spawn "~/.config/wehttamsnaps/scripts/jarvis-manager.sh"; }

    // Steam with iDroid launch sound
    Mod+Alt+S hotkey-overlay-title="Steam"                { spawn "sh" "-c" "sound-system steam-launch && steam"; }

    // ProtonUp-Qt
    Mod+Alt+P   hotkey-overlay-title="ProtonUp-Qt"          { spawn "protonup-qt"; }

    // Niri config validator
    Mod+Alt+r   hotkey-overlay-title="Niri Validate"        { spawn "~/bin/niri-validate.sh"; }

    // ╰──────────────────────────────────────────────────────────────────────────────╯

    // ╭─────────────────────────────── 11. SCREENSHOTS ─────────────────────────────╮

    // Full screen capture → file + J.A.R.V.I.S. sound
    Mod+F10       hotkey-overlay-title="Screenshot + Sound" {
        spawn "sh" "-c" "grim ~/Pictures/Screenshots/$(date +%Y%m%d-%H%M%S).png && sound-system screenshot";
    }

    // Niri native screenshot (no sound — use Mod+Print for the full experience)
    F10           hotkey-overlay-title="Screenshot (Screen)"     { screenshot-screen; }
    Ctrl+F10      hotkey-overlay-title="Screenshot (Window)"     { screenshot-window; }

    // Region screenshot via ii
    // (also bound above as Mod+Shift+S in section 2)

    // ╰──────────────────────────────────────────────────────────────────────────────╯

    // ╭─────────────────────────────── 12. AUDIO + MEDIA ───────────────────────────╮

    // Volume + mute — routed through sound-system for J.A.R.V.I.S. voice feedback
    XF86AudioMute           allow-when-locked=true  { spawn "sound-system" "mute"; }
    XF86AudioRaiseVolume    allow-when-locked=true  { spawn "sound-system" "volume-up"; }
    XF86AudioLowerVolume    allow-when-locked=true  { spawn "sound-system" "volume-down"; }
    XF86AudioMicMute        allow-when-locked=true  { spawn "sound-system" "mic-mute"; }

    // Media playback (playerctl — works with Spotify, Firefox, VLC, etc.)
    XF86AudioPlay   allow-when-locked=true  { spawn "playerctl" "play-pause"; }
    XF86AudioNext   allow-when-locked=true  { spawn "playerctl" "next"; }
    XF86AudioPrev   allow-when-locked=true  { spawn "playerctl" "previous"; }
    XF86AudioStop   allow-when-locked=true  { spawn "playerctl" "stop"; }

    // ╰──────────────────────────────────────────────────────────────────────────────╯
}
